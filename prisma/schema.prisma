generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")rmdir /s /q .next
}

model Donation {
  id            String   @id @default(cuid())
  fullName      String
  email         String
  amount        Int
  paymentMethod String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
}